# StudySphere Production Environment Configuration
# =============================================================================

# =============================================================================
# FIREBASE CLIENT SDK (injected into the front-end by Vite)
# Get these from Firebase Console → Project Settings → General → Your apps
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# =============================================================================
# FIREBASE ADMIN SDK (server-side only)
# Option A: Paste the entire service-account JSON as one line below.
# Option B: Set GOOGLE_APPLICATION_CREDENTIALS to the file path instead.
# =============================================================================
FIREBASE_SERVICE_ACCOUNT_KEY=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=8080
MAX_REQUEST_SIZE=10mb

# =============================================================================
# CORS CONFIGURATION
# Allowed Origins (comma-separated, NO WILDCARDS in production)
# =============================================================================
CORS_ORIGINS=https://your-domain.com

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=your-domain.com

# =============================================================================
# OPTIONAL – RATE LIMITING (defaults are already sensible)
# =============================================================================
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# OPTIONAL – MONITORING & LOGGING
# =============================================================================
# LOG_LEVEL=warn

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# 1. NEVER commit this file with real values to version control
# 2. Firebase client keys (VITE_*) are safe to expose — they only identify
#    your project.  Security is enforced by Firestore Security Rules +
#    Firebase Auth.
# 3. FIREBASE_SERVICE_ACCOUNT_KEY is a SECRET.  Keep it out of git.
# 4. Set CORS_ORIGINS to your actual domain(s) — no wildcards.

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
# ✅ FIREBASE_SERVICE_ACCOUNT_KEY is set (server can access Firestore)
# ✅ Firestore Security Rules restrict client-side access
# ✅ CORS_ORIGINS only includes your actual domains
# ✅ HTTPS is enabled (Netlify / load-balancer handles TLS)
# ✅ Security headers configured (CSP, HSTS, etc.)
# ✅ Rate limiting is enabled
# ✅ Error messages don't leak sensitive information
