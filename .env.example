# ──────────────────────────────────────────────
# Firebase Client SDK (used by the Vite/React front-end)
# Get these from Firebase Console → Project Settings → General → Your apps
# ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ──────────────────────────────────────────────
# Firebase Admin SDK (used by the Express server)
# Paste the entire JSON of your service-account key as a single-line string,
# or point GOOGLE_APPLICATION_CREDENTIALS to the key file path instead.
# ──────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=

# ──────────────────────────────────────────────
# General
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
