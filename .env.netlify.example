# ──────────────────────────────────────────────
# Netlify Environment Variables
# Copy these into your Netlify site → Site settings → Environment variables
# ──────────────────────────────────────────────

# Firebase Client SDK (prefix with VITE_ so Vite injects them into the client bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK — paste the ENTIRE service-account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_KEY=

# General
NODE_ENV=production
CORS_ORIGINS=https://your-app-name.netlify.app
